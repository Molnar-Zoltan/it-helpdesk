# Authentication
JWT_SECRET=your_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# AI
GEMINI_API_KEY=your_api_key_here

# Demo reset (Step 8.5) — shared secret for POST /admin/demo-reset, called
# only by the scheduled GitHub Actions workflow, never by a logged-in user
ADMIN_RESET_SECRET=your_admin_reset_secret_here

# Server
NODE_ENV=development
PORT=3001

# Rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AI_DAILY_LIMIT=10

# Cloudflare Turnstile (registration captcha) — secret key only.
# The backend never needs the site key; that's public and belongs in the
# frontend's env instead (NEXT_PUBLIC_TURNSTILE_SITE_KEY, added in Step 7.2).
# The value below is Cloudflare's official "always passes" test secret key —
# a safe default for local dev. Replace with the real secret key from the
# Cloudflare dashboard before deploying.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Frontend
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk

# Redis
# Local: redis://localhost:6379
# Production (Upstash): rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379