# Backend API URL. Server-only — the browser never talks to the backend
# directly, only to this Next.js app's own /api/auth/* and /api/backend/*
# route handlers, which proxy through to this URL with the access token
# injected server-side. Do NOT prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:3001

# Cloudflare Turnstile site key (registration captcha widget). Public by
# design — NEXT_PUBLIC_ so it ships to the browser, unlike BACKEND_API_URL
# above. The matching secret key lives in backend/.env.example instead,
# since only the backend calls Cloudflare's siteverify API.
# The value below is Cloudflare's official "always passes" test sitekey —
# a safe default for local dev. Replace with the real sitekey from the
# Cloudflare dashboard before deploying.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA