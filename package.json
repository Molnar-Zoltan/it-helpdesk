{
  "name": "it-helpdesk",
  "version": "0.12.1",
  "private": true,
  "description": "An IT helpdesk application where users can file tickets manually or by chatting with an AI assistant that extracts structured ticket details automatically. Built as a full-stack TypeScript monorepo to explore tool-calling AI integration, Redis-backed rate limiting, and role-based access control end to end.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run start:dev --workspace backend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=frontend --workspace=backend",
    "test": "npm run test --workspaces",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('husky', {stdio:'inherit'})\"",
    "postinstall": "npm run build --workspace=packages/shared",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "prisma:reset": "npm run prisma:reset --workspace=backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Molnar-Zoltan/it-helpdesk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Molnar-Zoltan/it-helpdesk/issues"
  },
  "homepage": "https://github.com/Molnar-Zoltan/it-helpdesk#readme",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": "22.23.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  }
}
